rules_version = '2';

// Bano's Cookbook — client (browser SDK) access rules.
//
// The Next.js server and the ventures-ops content engine use the Admin SDK / IAM and
// are not affected by these rules. Anything not matched below is denied.
//
// Recipe contract (shared with ventures-ops):
//   source  'ammi_book' | 'sample' | 'community'   status 'draft' | 'published' | 'hidden'
//   social  {eligible, excludePlatforms?, hookNote?}   (stream-d-contracts.md §1)
// Only status == 'published' is public. source, sourceBook, sourcePage, scanPath, scanUrl,
// status, social, ratings, comments, saves and Instagram bookkeeping are server-only.
//
// Tests: npm run test:rules (Firestore emulator, testing/rules/firestore.rules.test.ts)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── Recipes ────────────────────────────────────────────────────────────────

    // Content fields a signed-in owner may write from the client.
    function recipeContentFields() {
      return ['title', 'description', 'author', 'ingredients', 'instructions', 'prepTime',
              'cookTime', 'servings', 'cuisine', 'imageId', 'imageUrl', 'tags'];
    }

    function validRecipeContent(d) {
      return d.title is string && d.title.size() >= 3 && d.title.size() <= 200
        && (!('author' in d) || (d.author is string && d.author.size() <= 100))
        && (!('description' in d) || (d.description is string && d.description.size() <= 5000))
        && (!('ingredients' in d) || (d.ingredients is list && d.ingredients.size() <= 200))
        && (!('instructions' in d) || (d.instructions is list && d.instructions.size() <= 200))
        && (!('cuisine' in d) || (d.cuisine is string && d.cuisine.size() <= 100))
        && (!('imageUrl' in d) || (d.imageUrl is string && d.imageUrl.size() <= 2000))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 12));
    }

    function isRecipeOwner() {
      return signedIn() && resource.data.get('userId', '') == request.auth.uid;
    }

    match /recipes/{recipeId} {
      allow read: if resource.data.get('status', '') == 'published' || isAdmin() || isRecipeOwner();

      // Guests cannot create. Signed-in users create content only; the doc is theirs
      // and is not public until an admin publishes it server-side.
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.keys().hasOnly(recipeContentFields().concat(['userId']))
        && request.resource.data.userId == request.auth.uid
        && validRecipeContent(request.resource.data)
      );

      allow update: if isAdmin() || (
        isRecipeOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(recipeContentFields())
        && validRecipeContent(request.resource.data)
      );

      allow delete: if isAdmin() || (isRecipeOwner() && resource.data.get('source', '') != 'ammi_book');

      // Comments are written by the server (API routes) only.
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /recipeRatings/{ratingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Users ──────────────────────────────────────────────────────────────────

    // Profile fields a user may write on their own document. Never tier, role,
    // credits, admin flags, plan or billing fields.
    function profileFields() {
      return ['username', 'displayName', 'email', 'photoURL', 'bio', 'socialLinks',
              'createdAt', 'updatedAt'];
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && request.resource.data.keys().hasOnly(profileFields());
      allow update: if isSelf(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields());
      allow delete: if isAdmin();
    }

    // Credits are maintained by the server only.
    match /user_credits/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if false;
    }

    // ── Server-only and admin data ────────────────────────────────────────────

    // Platform tokens never reach a browser, not even an admin's.
    match /instagram_tokens/{docId} {
      allow read, write: if false;
    }

    match /instagram_posts/{postId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /video_scripts/{videoScriptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /generated_images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin/{document} {
      allow read, write: if isAdmin();
    }

    // Book page index (written by scripts/book/upload-pages.ts and /admin/ingest).
    match /book_pages/{pageId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
